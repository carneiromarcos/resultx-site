{
  "name": "resultx-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npx wrangler pages dev --proxy 5173 -- vite --port 5173",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resultx-design-system": "github:carneiromarcos/resultx-design-system#v2.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.11",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
